+class SessionContextEditEntry(ProtocolModel):
+    """One edit the editor model predicted, applied or reported verbatim.
+
+    Mirrors one item of the ConversationContextRepair schema the editor model
+    answered with. ``message_index`` is the number the numbered transcript
+    named, not a position in the stored history: the reply echoes the model's
+    own numbering, which is the only numbering the caller ever saw.
+    ``replacement_text`` rides ``replace`` and ``mask`` and stays ``None`` for
+    ``remove``, exactly as the schema's conditional requires.
+    """
+
+    message_index: int = Field(ge=0)
