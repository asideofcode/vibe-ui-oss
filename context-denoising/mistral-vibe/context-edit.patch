+    operation: Literal["replace", "remove", "mask"]
+    original_text: str = Field(min_length=1)
+    replacement_text: str | None = Field(default=None, min_length=1)
+    reason: str = ""
+
+
+class SessionContextEditResponse(ProtocolModel):
+    changed: bool
+    edits: list[SessionContextEditEntry] = Field(default_factory=list)
+    state: PublicSessionState
